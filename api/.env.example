# Use the pooled connection string from your Neon project.
# Replace the placeholder credentials and host before making database connections.
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-pooler.region.aws.neon.tech/biryani?ssl=require
# Optional non-pooled Neon URL, used only for Alembic migrations if PgBouncer
# does not support a required migration operation. Never use it in the app engine.
# DATABASE_URL_DIRECT=postgresql+asyncpg://user:password@ep-example.region.aws.neon.tech/biryani?ssl=require
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
JWT_EXPIRY_MINUTES=60
MOCK_OTP=123456
